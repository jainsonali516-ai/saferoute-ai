// Reference schema only — Prisma is not wired up in this hackathon build.
// Every model here currently lives in an in-memory demo store instead:
//   TrustedContact   -> src/lib/server/trustedContactsStore.ts
//   Journey/CheckIn  -> src/lib/server/journeyStore.ts
//   UserPreference   -> src/lib/server/preferencesStore.ts
//   PrivacySetting   -> src/lib/server/privacyStore.ts
// Route/Recommendation results are generated on demand by the Recommendation
// Engine (src/lib/server/recommendationEngine.ts) and are not persisted at
// all in the demo — add a Recommendation table only if you want to keep a
// history of what was shown to a user.
//
// When a real database is added, generate the client from this schema and
// swap each store's functions for the equivalent `prisma.<model>.*` calls —
// the API routes under src/app/api/** do not need to change shape.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  createdAt       DateTime         @default(now())
  trustedContacts TrustedContact[]
  journeys        Journey[]
  preference      UserPreference?
  privacySetting  PrivacySetting?
}

model TrustedContact {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phoneNumber  String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Journey {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin            String
  destination       String
  mode              String
  routeId           String
  routeKind         String
  etaMinutes        Int
  startedAt         DateTime  @default(now())
  expectedArrivalAt DateTime
  status            String // active | overdue | completed | cancelled
  shareWithContactId String?
  completedAt       DateTime?
  checkIns          CheckIn[]

  @@index([userId])
}

model CheckIn {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  status    String // "ok" — the UI never auto-asserts anything worse
  createdAt DateTime @default(now())

  @@index([journeyId])
}

// One row per route generated by the Recommendation Engine for a comparison.
// Optional in the demo (results are computed on demand, not persisted) —
// add writes here only if you want a history of what was shown to users.
model Recommendation {
  id                   String   @id @default(cuid())
  journeyId            String?
  routeKind            String // fastest | safer | balanced
  durationMinutes      Int
  distanceKm           Float
  estimatedContextScore Int
  confidence           String // low | medium | high
  factors              Json
  explanations         Json
  createdAt            DateTime @default(now())
}

model ContextSnapshot {
  id                     String   @id @default(cuid())
  weatherCondition       String
  weatherTempC           Int
  trafficLevel           String
  publicActivityLevel    String
  transportAvailability  String
  generatedAt            DateTime @default(now())
}

model UserPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredModes       Json // TravelMode[]
  walkingTolerance     String // low | medium | high
  routePriority        Int // 0 (fastest) - 100 (safer)
  wheelchairAccessible Boolean @default(false)
  avoidStairs          Boolean @default(false)
  avoidPoorlyLit       Boolean @default(true)
}

model PrivacySetting {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationSharing         Boolean @default(false)
  saveJourneyHistory      Boolean @default(false)
  shareWithTrustedContact Boolean @default(false)
  analyticsConsent        Boolean @default(false)
}
