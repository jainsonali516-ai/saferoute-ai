# Copy this file to .env.local and fill in real values when you're ready to
# move off mock data. The app runs end-to-end with none of these set.

# When true (default if unset), every provider in the Context Engine and the
# Recommendation Engine uses mock/demo data — no external API keys required.
DEMO_MODE=true

# Base URL the frontend uses for API calls. Same-origin Next.js API routes
# need this to stay empty/unset in local dev — only set it if the frontend
# and API are ever split into separate deployments.
NEXT_PUBLIC_API_URL=

# Only needed if you swap the in-memory demo stores (trusted contacts,
# journeys, preferences, privacy settings) for Prisma + Postgres.
# See prisma/schema.prisma for the intended models.
DATABASE_URL=

# WIRED UP: set these to persist trusted contacts in a real Postgres table
# (see supabase/migrations) instead of the in-memory DEMO MODE store
# (src/lib/server/trustedContactsStore.ts). Get them from your Supabase
# project settings -> API. SUPABASE_SERVICE_ROLE_KEY is a secret: it bypasses
# row-level security and must only ever be read by server-side code (never
# NEXT_PUBLIC_-prefixed, never sent to the browser). Leave unset to keep
# using the in-memory store — the app falls back automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed once real user accounts/sessions replace the anonymous demo
# cookie in src/lib/server/auth.ts.
JWT_SECRET=

# WIRED UP: set this to activate real current-conditions weather (OpenWeatherMap)
# for the destination in route comparisons (src/lib/server/providers/weatherProvider.ts).
# Get a free key at https://openweathermap.org/api (no credit card required,
# 1,000 calls/day). Leave unset to keep using the simulated weather generator.
# Real provider keys are never referenced from any client component — only
# server-side modules under src/lib/server/** may read these.
WEATHER_API_KEY=
TRAFFIC_API_KEY=

# WIRED UP: set this to activate real geocoding + routing (Mapbox) in the
# Recommendation Engine (src/lib/server/providers/mapsProvider.ts). Get a
# free token at https://account.mapbox.com/access-tokens/ (no credit card
# required). Leave unset to keep using the synthetic route generator — the
# app falls back automatically if this is missing or a lookup fails.
MAPBOX_ACCESS_TOKEN=

# Optional: powers the app/instruments demo page (src/lib/supabase/client.ts).
# Publishable/anon key only — safe to expose to the browser. Get these from
# your Supabase project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WIRED UP: set these to send real SMS emergency alerts to trusted contacts
# (src/lib/server/providers/smsProvider.ts) via Twilio. Get them from
# https://console.twilio.com (Account SID + Auth Token) and a Twilio phone
# number capable of sending SMS. Leave unset to keep using DEMO MODE, which
# logs the message server-side instead of sending it — the emergency alert
# flow works either way.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
